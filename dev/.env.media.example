# Local RustFS administrator credentials. Generate unique random values.
RUSTFS_ADMIN_ACCESS_KEY=replace-with-random-admin-key
RUSTFS_ADMIN_SECRET_KEY=replace-with-random-admin-secret

# Leave Supabase selected until the bucket and restricted application identity exist.
PROFILE_MEDIA_PROVIDER=supabase
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=acs-media
RUSTFS_APP_ACCESS_KEY_ID=
RUSTFS_APP_SECRET_ACCESS_KEY=
RUSTFS_PUBLIC_BASE_URL=http://localhost:3000/media/acs-media
